# Recursive-backend environment variables.
# Copy to `.env` and fill in real values. Never commit `.env` (it is gitignored).

# --- Server ---
PORT=3001
SITE_URL=https://www.recursiverecordings.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Auth (admin JWTs) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_EMAIL=

# --- Contract signing (owner signature) ---
# Optional: a full data: URL used to embed the owner signature on generated
# contracts. If unset, the committed asset at src/assets/owner-signature.png
# (or an uploaded contracts/_assets/owner-signature.png) is used instead.
OWNER_SIGNATURE_DATA_URL=

# --- BoldSign e-signature (contract signing) ---
BOLDSIGN_BASE_URL=https://api.boldsign.com
BOLDSIGN_API_KEY=
BOLDSIGN_WEBHOOK_SECRET=
